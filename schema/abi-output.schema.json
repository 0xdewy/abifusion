{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abifusion/schema/abi-output.schema.json",
  "title": "abifusion reconstructed ABI output",
  "description": "The language-neutral output of fuse_abi / ABIFusion.reconstruct. Version 1.",
  "type": "object",
  "required": ["functions", "metadata"],
  "properties": {
    "functions": {
      "type": "array",
      "items": { "$ref": "#/$defs/function" }
    },
    "metadata": {
      "type": "object",
      "required": ["function_count", "evmole_selectors", "extra_selectors"],
      "properties": {
        "function_count": { "type": "integer", "minimum": 0 },
        "evmole_selectors": { "type": "integer", "minimum": 0 },
        "extra_selectors": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "function": {
      "type": "object",
      "required": ["type", "name", "selector", "inputs", "source", "confidence"],
      "properties": {
        "type": { "const": "function" },
        "name": { "type": "string" },
        "selector": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "name"],
            "properties": {
              "type": { "type": "string" },
              "name": { "type": "string" }
            }
          }
        },
        "source": {
          "type": "string",
          "enum": [
            "signature+evmole",
            "signature",
            "evmole",
            "known-selector-table",
            "ml",
            "selector",
            "known-interface-completion",
            "known-interface-completion-post"
          ]
        },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "candidates": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "required": ["name", "types", "source"],
            "properties": {
              "name": { "type": "string" },
              "types": { "type": "array", "items": { "type": "string" } },
              "source": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
