# abifusion - Environment Configuration
# Copy this file to .env and fill in your API keys

# ============================================================================
# REQUIRED: Etherscan API Configuration
# ============================================================================

# Get your free API key from: https://etherscan.io/apis
# Required for fetching verified contract data from Etherscan
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ============================================================================
# OPTIONAL: Advanced Configuration
# ============================================================================

# Rate limiting (seconds between API calls)
# Etherscan has a rate limit of 5 calls/second for free tier
ETHERSCAN_RATE_LIMIT=0.2

# Sourcify configuration (alternative source for verified contracts)
SOURCIFY_RATE_LIMIT=0.1

# ============================================================================
# DATA & CACHE CONFIGURATION
# ============================================================================

# Cache time-to-live in seconds (default: 24 hours)
# Set to 0 to disable caching
CACHE_TTL=86400

# Data directory (relative to project root)
DATA_DIR=../abifusion_data

# Maximum contracts to fetch during training
TARGET_CONTRACTS=100

# ============================================================================
# MODEL TRAINING CONFIGURATION
# ============================================================================

# Training parameters (can be overridden via command line)
TRAINING_EPOCHS=50
TRAINING_BATCH_SIZE=32
LEARNING_RATE=0.01

# Model architecture
NEURAL_NET_INPUT_DIM=100
NEURAL_NET_HIDDEN_DIM=64

# ============================================================================
# INFERENCE CONFIGURATION
# ============================================================================

# Default model path
DEFAULT_MODEL_PATH=../abifusion_data/models/neural_disambiguator.pkl

# Confidence thresholds for inference results
CONFIDENCE_HIGH_THRESHOLD=0.7
CONFIDENCE_MEDIUM_THRESHOLD=0.3

# ============================================================================
# LOGGING & DEBUGGING
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable/disable verbose output
VERBOSE=false

# ============================================================================
# NETWORK & PROXY SETTINGS
# ============================================================================

# HTTP proxy (if needed)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080

# Request timeout in seconds
REQUEST_TIMEOUT=30

# ============================================================================
# NOTES:
# ============================================================================
# 1. Always keep your API keys secure. Never commit .env files to version control.
# 2. Add .env to your .gitignore file.
# 3. For production, consider using environment variables instead of .env file.
# 4. Etherscan free tier limits: 5 calls/second, 100,000 calls/day
# 5. Sourcify is free and has no rate limits, but may have incomplete data.